{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git ls-files*)",
      "Bash(npm test*)",
      "Bash(npm run dev*)",
      "Bash(npm start*)",
      "Bash(npx expo start*)",
      "Bash(node -e*)",
      "Bash(node --check*)",
      "Bash(git checkout *)",
      "Bash(git pull *)",
      "Bash(git stash *)",
      "Bash(git fetch *)"
    ],
    "deny": [
      "Read(./backend/.env)",
      "Read(./backend/.env.local)",
      "Read(./backend/.env.production)",
      "Read(./frontend/.env)",
      "Read(./frontend/.env.local)",
      "Read(./frontend/.env.production)",
      "Read(./.git/config)",
      "Edit(./backend/.env)",
      "Edit(./frontend/.env)",
      "Edit(./frontend/App.js.backup)",
      "Edit(./backend/logs/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(git clean*)",
      "Bash(git rebase*)",
      "Bash(git commit --amend*)",
      "Bash(git branch -D*)",
      "Bash(git branch -d*)",
      "Bash(git remote -v*)",
      "Bash(eas build*)",
      "Bash(eas submit*)",
      "Bash(eas update*)",
      "Bash(npm publish*)",
      "Bash(rm -rf*)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(git push --force*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(eas build*)",
      "PowerShell(eas submit*)",
      "PowerShell(Remove-Item -Recurse*)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git add*)",
      "Bash(git push*)",
      "Bash(npm install*)",
      "Bash(npm uninstall*)",
      "Bash(npx expo install*)",
      "PowerShell(git commit*)",
      "PowerShell(git push*)",
      "PowerShell(npm install*)"
    ]
  }
}
